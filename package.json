{
  "name": "cafe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "typecheck": "tsc --build",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "demo": "pnpm --filter @cafe/demos record",
    "dev:mcp": "pnpm --filter @cafe/live-mcp dev",
    "build:mcp": "pnpm --filter @cafe/live-mcp build",
    "test:mcp": "pnpm --filter @cafe/live-mcp test",
    "dev:music": "bash scripts/dev-music-mcp.sh",
    "lint:music": "cd integrations/strudellm && npm run lint",
    "build:music": "cd integrations/strudellm && npm run build"
  },
  "dependencies": {
    "@cafe/api": "workspace:*",
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@cafe/backend": "workspace:*",
    "@cafe/frontend": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
