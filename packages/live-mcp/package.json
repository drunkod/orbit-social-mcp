{
  "name": "@cafe/live-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && tsx server/index.ts",
    "build": "VITE_CAFE_PREVIEW=true VITE_MCP_PLUGINS_URL=/ pnpm --filter @cafe/frontend build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:visual": "tsx scripts/test-cafe-plugins.ts",
    "test:music": "tsx scripts/smoke-music.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "effect": "catalog:",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
